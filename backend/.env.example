# Copy this file to backend/.env and fill in the values you need.
# Never commit .env — it is listed in .gitignore.

# ------------------------------------------------------------
# Model provider: "local" (Ollama) or "cloud" (Anthropic API)
# ------------------------------------------------------------
MODEL_PROVIDER=local

# Required when MODEL_PROVIDER=cloud
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional overrides for the local Ollama provider
LOCAL_API_URL=http://localhost:11434/api/chat
LOCAL_MODEL=qwen3.5:9b
LOCAL_NUM_CTX=4096
LOCAL_NUM_PREDICT=300

# ------------------------------------------------------------
# Flask / database
# ------------------------------------------------------------
SECRET_KEY=change-this-to-a-random-secret-in-production
DATABASE_URL=sqlite:///psych_app.db
PORT=5000
